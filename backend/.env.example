# Copy to .env and adjust as needed. The backend reads DATABASE_URL and
# CORS_ORIGINS from the environment; .env is git-ignored.

# Default database: the PostgreSQL service in docker-compose.yml (repo root).
DATABASE_URL=postgresql+psycopg://regulatory:regulatory@localhost:5432/regulatory

# Zero-dependency fallback - no database server required:
# DATABASE_URL=sqlite:///./regulatory.db

# Comma-separated frontend origins allowed by CORS.
# CORS_ORIGINS=http://localhost:5151,http://127.0.0.1:5151
